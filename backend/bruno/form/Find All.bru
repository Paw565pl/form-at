meta {
  name: Find All
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/forms
  body: none
  auth: inherit
}

params:query {
  ~searchQuery: cat
  ~language: EN
  ~minEstimatedDuration: PT2M
  ~maxEstimatedDuration: PT5M
  ~allowsGuestSubmissions: false
  ~authorId: 8075272c-48fb-46ff-aed8-946853230459
  ~sort: submissionsCount,desc
  ~page: 0
  ~size: 20
}

settings {
  encodeUrl: true
  timeout: 0
}
